# Broker used for both subscribing and publishing.
MQTT_HOST=your-broker.example.com
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS=false
# Optional custom CA path inside the container (requires a volume mount).
MQTT_CA_FILE=

MQTT_INPUT_TOPIC=msh/#
MQTT_OUTPUT_TOPIC=auto
MESHTASTIC_KEY=AQ==
# Local channel index used by legacy firmware JSON for encrypted uplinks.
MQTT_CHANNEL_INDEX=0
MQTT_QOS=1
# Empty lets Paho generate a unique client ID.
MQTT_CLIENT_ID=
LOG_LEVEL=INFO
